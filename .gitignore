# Rust build artifacts
rust/target/

# Bundled Python distribution (created by rust/setup-python.sh)
rust/python-dist/

# Bundled Rust compiler distribution (created by scripts/setup-rustc.sh)
rustc-dist/

# License key generation tool build artifacts and private key
tools/generate-license/target/
tools/generate-license/keypair.bin

# Test license serial (generated by scripts/generate-test-serial.sh)
.test-serial

# Bundled Monaco Editor (created by scripts/setup-monaco.sh)
ConjureDSPExtension/Resources/monaco/vs/
ConjureDSPExtension/Resources/monaco/LICENSE

# Xcode build artifacts
build/
DerivedData/

# Sentry CLI config (contains auth token)
.sentryclirc

# Xcode user-specific files
*.xcuserstate
xcuserdata/
