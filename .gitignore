# Rust build artifacts
rust/target/

# Bundled Python distribution (created by rust/setup-python.sh)
rust/python-dist
rust/python-dist/

# Bundled Rust compiler distribution (created by scripts/setup-rustc.sh)
rustc-dist
rustc-dist/

# Bundled uv package manager (created by scripts/setup-uv.sh)
uv-dist
uv-dist/

# License key generation tool build artifacts and private key
tools/generate-license/target/
tools/generate-license/keypair.bin

# Test license serial (generated by scripts/generate-test-serial.sh)
.test-serial

# Bundled Monaco Editor (created by scripts/setup-monaco.sh)
ConjureDSPExtension/Resources/monaco/vs
ConjureDSPExtension/Resources/monaco/vs/
ConjureDSPExtension/Resources/monaco/LICENSE

# Bundled xterm.js (created by scripts/setup-xterm.sh)
ConjureDSPExtension/Resources/terminal/xterm.js
ConjureDSPExtension/Resources/terminal/xterm.css
ConjureDSPExtension/Resources/terminal/addon-*.js

# Xcode build artifacts
build/
DerivedData/

# Sentry CLI config (contains auth token)
.sentryclirc

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Xcode user-specific files
*.xcuserstate
xcuserdata/
rust/conjuredsp/__pycache__/

# Claude Code worktrees
.claude/worktrees/
DAW Projects/

# Cloudflare Workers server dependencies and build cache
server/node_modules/
server/.wrangler/

# Environment variables (Paddle API keys, etc.)
.env

# Root-level Wrangler cache (sibling server/.wrangler is already ignored above)
.wrangler/

# Stray cargo-home from dev/test runs (the real one lives in the app group container)
cargo-home/

# Stray NAM export at repo root (tracked .nam files live under tone3000_py_demo/)
/passthrough-approximation.nam
