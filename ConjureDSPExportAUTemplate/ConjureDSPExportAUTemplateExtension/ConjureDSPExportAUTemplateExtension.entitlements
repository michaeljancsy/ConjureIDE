<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- WKWebView's Networking Process requires this even when the webview
	     only serves content via WKURLSchemeHandler. Without it, WebContent
	     crashes on launch with "Application does not have permission to
	     communicate with network resources" and the custom UI renders blank. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Group Containers/group.com.MichaelJancsy.ConjureDSP/PythonRuntime/</string>
	</array>
</dict>
</plist>
