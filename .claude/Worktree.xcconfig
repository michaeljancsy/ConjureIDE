// Per-worktree build overrides (Debug only).
//
// This file is referenced as baseConfigurationReference for Debug build
// configurations of ConjureDSP, ConjureDSPExtension, ConjureDSPTerminal,
// and their test targets. Variables here are substituted into bundle IDs,
// AU subtypes, and AU display names so that Debug builds from different
// git worktrees don't collide in LaunchServices, PluginKit, or when running
// `open` on the .app.
//
// Main repo / default: all variables empty → Debug builds use the
// historical IDs (e.g. com.MichaelJancsy.ConjureDSP.debug, AU subtype DBG1).
//
// Per-worktree: .claude/Worktree.local.xcconfig (gitignored, generated by
// scripts/setup-worktree-identity.sh) overrides these with values derived
// from the worktree's directory name. Release configs are unaffected —
// production bundle IDs never get a suffix.
//
// If the local override file is absent (main repo checkout without having
// run the setup script), defaults below apply and builds behave exactly
// as they did before this file existed.

// Appended to Debug bundle IDs after ".debug" (with leading dot, or empty
// for the main worktree). Example: ".infallible-elion"
CD_WORKTREE_SUFFIX =

// 1 char appended to "DBG" to form the AU subtype. Must be unique per
// worktree. Default "1" matches the historical DBG1 subtype.
CD_WORKTREE_AU_TAG = 1

// Human-readable worktree tag included in AU display name. Empty for main.
CD_WORKTREE_DISPLAY =

// Optional local override — written by setup-worktree-identity.sh in
// worktrees. Missing-file is not an error.
#include? "Worktree.local.xcconfig"
